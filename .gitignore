# KiCad local state, cache, and lock files
*.kicad_prl
*.kicad_sch-bak
fp-info-cache
fp-info-cache.bak-*
fp-lib-table
fp-lib-table.bak-*
*-cache.lib
*-rescue.*
~*.lck
\#auto_saved_files\#/
_autosave-*

# KiCad/local backup folders
**/.history/
**/*-backups/
**/_restore_backup_*/
**/production/backups/

# Generic backup/log files generated by local tools
*.bak
*.bak-*
*.log

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
